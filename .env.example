# ── Base de données ──────────────────────────────────────────
# En local avec `docker compose up -d`, ces identifiants correspondent
# à docker-compose.yml. Sur le VPS, pointe vers le conteneur Postgres
# de prod (ou un service managé).
DATABASE_URL="postgresql://xplosion:xplosion@localhost:5432/xplosion?schema=public"

# ── Auth.js (NextAuth v5) ────────────────────────────────────
# Génère un secret unique avec : openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
